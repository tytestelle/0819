<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp">
            <TextView
                android:textSize="18dp"
                android:textColor="@color/color_FFFFFF_90"
                android:gravity="start|center_vertical"
                android:id="@+id/castTitle"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="37dp"
                android:text="可投屏设备"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/reButton"
                android:background="@drawable/shape_cast_refresh_button_style"
                android:focusable="true"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_refresh"
                android:scaleType="fitCenter"/>
        </LinearLayout>
        <View
            android:background="@color/color_FFFFFF_20"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="20dp"/>
        <com.github.tvbox.osc.ui.tv.CustomView.CustomRecyclerView
            android:id="@+id/cast_GridView"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            app:maxHeight="260dp"/>
    </LinearLayout>
</LinearLayout>
