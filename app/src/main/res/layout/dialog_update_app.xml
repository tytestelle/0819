<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:paddingBottom="20dp"
    android:layout_width="380dp"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <TextView
        android:textSize="18dp"
        android:textColor="@color/color_FFFFFF_90"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"/>
    <View
        android:background="@color/color_FFFFFF_20"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="20dp"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/color_FFFFFF_90"
        android:gravity="start"
        android:id="@+id/size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/color_FFFFFF_90"
        android:gravity="start"
        android:id="@+id/mes"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:maxLines="6"
        android:lineSpacingExtra="8dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="37dp">
        <FrameLayout
            android:gravity="center"
            android:id="@+id/frameLayout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="37dp">
            <ProgressBar
                android:gravity="center"
                android:id="@+id/update_progressbar"
                android:layout_width="match_parent"
                android:layout_height="37dp"
                android:max="100"
                android:progress="0"
                android:layout_weight="1"
                style="@style/bottom_epgtime_progress_horizontal"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/color_FFFFFF_90"
                android:gravity="center"
                android:id="@+id/percentage"
                android:layout_width="match_parent"
                android:layout_height="37dp"
                android:text="已完成\90%"
                android:layout_weight="1"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="37dp">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/color_FFFFFF_90"
                android:gravity="center"
                android:id="@+id/ok"
                android:background="@drawable/shape_dialog_button_style"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="10dp">
                <requestFocus/>
            </TextView>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/color_FFFFFF_90"
                android:gravity="center"
                android:id="@+id/cancel"
                android:background="@drawable/shape_dialog_button_style"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
